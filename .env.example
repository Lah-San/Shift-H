# copy to .env and fill in; .env is git-ignored
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-2.5-flash,gemini-flash-lite-latest
ADMIN_PASSWORD=admin
MANAGER_PASSWORD=manager
STAFF_PASSWORD=password
# optional: outbound email (e.g. Brevo SMTP relay: smtp-relay.brevo.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
